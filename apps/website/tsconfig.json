{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "preserve",
        "allowJs": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        },
        "incremental": true
    },
    "include": ["src", "scripts", "next-env.d.ts", "*.config.ts", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
