{
  "name": "tekomltd",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "content:check": "turbo content:check",
    "import:wp": "pnpm --filter @tekom/website import:wp",
    "seed:mockup": "pnpm --filter @tekom/website seed:mockup"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "semantic-release": "25.0.9",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "brace-expansion": "^2.0.2"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
