{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**", "$TURBO_ROOT$/design/wordpress-snapshot/url-map.json"],
            "env": ["CONTENT_ROOT", "SITE_URL"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "content:check": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**", "$TURBO_ROOT$/design/wordpress-snapshot/url-map.json"]
        }
    }
}
