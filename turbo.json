{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "content:check": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"]
        }
    }
}
